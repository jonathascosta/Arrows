# Signs the iOS app for the App Store and uploads it to TestFlight. Run by the
# TestFlight workflow (.github/workflows/testflight.yml) from apps/game/ios/App,
# after the web build has been copied in (`cap sync ios`). Everything secret comes
# from the environment; docs/ARCHITECTURE.md (iOS) lists it.

default_platform(:ios)

APP_ID = "com.jonathascosta.arrows"
# Google's test AdMob app, until the owner's is set (ADMOB_APP_ID).
TEST_ADMOB_APP_ID = "ca-app-pub-3940256099942544~1458002511"

platform :ios do
  desc "Build, sign and upload a build to TestFlight"
  lane :beta do
    # A temporary keychain that holds the certificate for this run only.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true
    )

    certificate = File.expand_path("distribution.p12")
    File.binwrite(certificate, Base64.decode64(ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_P12")))
    import_certificate(
      certificate_path: certificate,
      certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
    )

    # Creates the App Store profile for the app on the first run, downloads it after.
    profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_ID,
      team_id: ENV.fetch("APPLE_TEAM_ID")
    )

    update_code_signing_settings(
      path: "App.xcodeproj",
      targets: ["App"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_uuid: lane_context[SharedValues::SIGH_UUID],
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    increment_build_number(xcodeproj: "App.xcodeproj", build_number: ENV.fetch("BUILD_NUMBER"))

    admob_app_id = ENV["ADMOB_APP_ID"].to_s.empty? ? TEST_ADMOB_APP_ID : ENV["ADMOB_APP_ID"]
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => lane_context[SharedValues::SIGH_NAME] } },
      xcargs: "ADMOB_APP_ID='#{admob_app_id}'",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    UI.success("Uploaded #{profile ? File.basename(profile) : 'the build'} to TestFlight")
  end
end
