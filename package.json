{
  "name": "arrows",
  "version": "0.0.0",
  "private": true,
  "description": "Arrows: a single-player puzzle game for iPhone with infinite generated levels.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @arrows/game dev",
    "preview": "pnpm --filter @arrows/game preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run --project \"!calibration\"",
    "test:watch": "vitest --project \"!calibration\"",
    "test:calibration": "vitest run --project calibration",
    "test:e2e": "pnpm --filter @arrows/game test:e2e",
    "test:a11y": "pnpm --filter @arrows/game test:a11y",
    "drawings": "pnpm --filter @arrows/tools drawings",
    "drawings:check": "pnpm --filter @arrows/tools drawings:check",
    "ios:sync": "pnpm --filter @arrows/game build && pnpm --filter @arrows/game exec cap sync ios",
    "prepare": "husky",
    "store:screenshots": "pnpm --filter @arrows/game store:screenshots"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
